# DiffDoc local environment — copy to .env.local and fill in the secrets.

# Supabase project: DiffDoc (eu-west-2, ref sngukuhttvamqtiuuwpz)
NEXT_PUBLIC_SUPABASE_URL=https://sngukuhttvamqtiuuwpz.supabase.co

# Publishable (client) key — safe to expose to the browser.
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_dOlqjYvbnc5qtnufga754Q_NDXvQYj5

# Service-role key — SERVER ONLY, bypasses RLS. Never expose to the browser.
# Copy from: Supabase dashboard → Project Settings → API → service_role.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret for the daily /api/keepalive cron (stops Supabase pausing the
# project). Vercel sends it as a Bearer token. Any long random string; set the
# same value in the Vercel project's env vars.
CRON_SECRET=
